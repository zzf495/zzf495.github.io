{% comment %}
  Site-specific publication renderer for the CV.
  The al_folio_cv renderer passes the current section entries in `entries`.
  Keep `journal` as the source field and fall back to `publisher` for legacy data.
{% endcomment %}

<style>
  .cv-publication-venue {
    margin-top: -0.2rem;
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
    color: var(--global-text-color-light, #6c757d);
  }
</style>

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% capture pub_date %}
      {% if entry.releaseDate %}{{ entry.releaseDate }}{% elsif entry.date %}{{ entry.date }}{% endif %}
    {% endcapture %}
    {% assign pub_date = pub_date | strip %}

    <li class="list-group-item">
      <div class="row">
        {% if pub_date != '' %}
          <div class="col-xs-2 col-sm-2 col-md-2 text-center">
            <table class="table-cv">
              <tbody>
                <tr>
                  <td>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                      {{- pub_date | split: '-' | slice: 0, 1 | join: '' -}}
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
        {% else %}
          <div class="col-xs-12 col-sm-12 col-md-12">
        {% endif %}

            {% if entry.url %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">
                <a href="{{ entry.url }}">{{ entry.title | default: entry.name }}</a>
              </h6>
            {% elsif entry.title %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.title }}</h6>
            {% elsif entry.name %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.name }}</h6>
            {% endif %}

            {% if entry.journal or entry.publisher %}
              <div class="cv-publication-venue ml-1 ml-md-4">
                <em>{{ entry.journal | default: entry.publisher }}</em>
              </div>
            {% endif %}

            {% if entry.summary %}
              <p class="ml-1 ml-md-4">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            {% endif %}
          </div>
      </div>
    </li>
  {% endfor %}
</ul>
